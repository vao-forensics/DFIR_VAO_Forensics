# secrets and per-install state: generated by install.sh, never committed
.env
.env.*
!.env.example
state/
*.token
*_token
*.pem
*.key

# case data and runtime output
cases/
users/
uploads/
var/
backups/
ram_inbox/
ram_results/
logs/

# models, databases, archives, binaries
*.gguf
*.onnx
*.sqlite
*.sqlite-*
*.bloom
*.zip
*.7z
*.rar
*.exe
*.dll
*.whl
*.vmdk
*.iso

# python / editor
__pycache__/
*.pyc
.venv/
.vscode/
*.swp
*.bak*

# collector build input fetched by install.sh (licensed third-party tools)
collector_kit/

# live data of the containers (bind mounts created by install.sh): databases, n8n credentials and its
# encryption key, vector store, pgAdmin sessions - never part of a fork or a pull request
services/n8n/
services/qdrant/
services/pgadmin/
services/logdb/data/
DFIR_VAO_credentials.txt
