{
 "_comment": [
  "What DFIR Collector Builder downloads and where each file lands under Modules\\bin.",
  "tier: fast = extracted for FAST collections, full = only for FULL. Everything outside Modules\\bin is core.",
  "kind: file (url is the file itself), zip / 7z / msi / nupkg (take 'take' out of the archive),",
  "      zipdir (unpack the whole archive into 'dest'), user (the person points the builder at a file they downloaded).",
  "Always the newest: 'github'+'asset' = newest release (GitHub's per-asset sha256 digest is checked); other urls are",
  "      re-checked with HEAD (ETag/Last-Modified) on every build, so the cache never serves an old file.",
  "sha256 pins the FINAL file; with 'pin_tag' the pin holds only for that release (a newer one is checked by digest/signature).",
  "signer: the main program must carry a valid Authenticode signature of this publisher (WinVerifyTrust).",
  "Fallback: when the official source fails or fails verification, {mirror}/<id>.<ext> (or mirror_name) is used and must",
  "      match {mirror}/SHA256SUMS. tools/collector_mirror_sync.py fills the mirror. Version+check land in TOOLS_PROVENANCE.txt.",
  "{mirror} = https://github.com/<this repository>/releases/download/tools-mirror : tools whose upstream disappeared or",
  "dropped the .NET Framework build the collector needs (targets must run with no runtime installed)."
 ],
 "user": [
  {
   "id": "kape",
   "required": true,
   "dest": "..\\..",
   "take": [
    "kape.exe"
   ],
   "label": "KAPE (Kroll)",
   "page": "https://www.kroll.com/en/services/cyber/incident-response-recovery/kroll-artifact-parser-and-extractor-kape",
   "note": "Free; Kroll emails a download link after a short form. Point the builder at the downloaded kape.zip."
  },
  {
   "id": "thor-lite",
   "required": false,
   "tier": "full",
   "dest": "thor-lite",
   "license_file": "*.lic",
   "label": "THOR Lite (Nextron)",
   "page": "https://www.nextron-systems.com/thor-lite/",
   "note": "Free licence for registered users; give the builder the THOR Lite zip and your .lic file."
  },
  {
   "id": "memory",
   "required": false,
   "tier": "fast",
   "dest": "memory",
   "take": [
    "DumpIt.exe",
    "MRCv120.exe"
   ],
   "label": "Magnet DumpIt / RAM Capture",
   "page": "https://www.magnetforensics.com/resources/magnet-dumpit-for-windows/",
   "note": "Needed only for RAM capture; registration required by Magnet."
  }
 ],
