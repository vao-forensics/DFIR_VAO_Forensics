[Unit]
Description=DFIR Silent Push gateway for Open WebUI (daily quota + audit)
After=docker.service network-online.target
[Service]
ExecStartPre=/bin/sh -c "for i in $(seq 1 30); do ip -4 addr | grep -q 172.18.0.1 && exit 0; sleep 2; done; exit 1"
ExecStart=/usr/bin/python3 /srv/dfir/tools/sp_gateway.py
Environment=SP_DAILY_LIMIT=60
Restart=always
RestartSec=5
NoNewPrivileges=yes
[Install]
WantedBy=multi-user.target
